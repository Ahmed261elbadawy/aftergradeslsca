{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/(images|style.css)(.*)", "dest": "/public/$1$2" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
