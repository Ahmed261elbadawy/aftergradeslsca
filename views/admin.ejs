<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin, After Grad 2026</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="admin-wrap">
    <div class="admin-header">
      <h1>Submissions (<%= submissions.length %>)</h1>
      <div class="actions-top">
        <a href="/admin/export.csv" class="btn btn-outline" style="text-decoration:none; display:inline-flex; align-items:center;">Export to Excel (CSV)</a>
        <form action="/admin/logout" method="POST">
          <button type="submit" class="btn-outline">Log Out</button>
        </form>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-box">
        <div class="stat-value"><%= viewStats.lastDay %></div>
        <div class="stat-label">link opens, last 24 hours</div>
      </div>
      <div class="stat-box">
        <div class="stat-value"><%= viewStats.lastWeek %></div>
        <div class="stat-label">link opens, last 7 days</div>
      </div>
      <% if (duplicateGroups.length > 0) { %>
        <div class="stat-box stat-box-warn">
          <div class="stat-value"><%= duplicateGroups.length %></div>
          <div class="stat-label">duplicate group<%= duplicateGroups.length === 1 ? '' : 's' %> found</div>
        </div>
      <% } %>
    </div>

    <% if (submissions.length === 0) { %>
      <div class="empty-state">No submissions yet.</div>
    <% } else { %>
      <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Screenshot</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Social Media</th>
            <th>Coming With</th>
            <th>Paid To</th>
            <th>Status</th>
            <th>Submitted</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% submissions.forEach(function(s) { %>
            <tr>
              <td>
                <a href="<%= s.screenshot_url %>" target="_blank">
                  <img class="thumb" src="<%= s.screenshot_url %>" alt="screenshot">
                </a>
              </td>
              <td>
                <%= s.name %>
                <% if (dupIdToGroupIndex.has(String(s.id))) { %>
                  <button type="button" class="dup-badge" onclick="openDupModal(<%= dupIdToGroupIndex.get(String(s.id)) %>)">
                    <%= duplicateGroups[dupIdToGroupIndex.get(String(s.id))].length %> duplicates
                  </button>
                <% } %>
              </td>
              <td><%= s.phone %></td>
              <td><%= s.social_media || '-' %></td>
              <td><%= s.guest_of || '-' %></td>
              <td><%= s.paid_to || '-' %></td>
              <td>
                <span class="badge badge-<%= s.status %>" data-badge-for="<%= s.id %>"><%= s.status === 'rejected' ? 'fake' : s.status %></span>
              </td>
              <td><%= s.created_at %></td>
              <td>
                <div class="actions-row">
                  <select class="status-select" data-id="<%= s.id %>" onchange="updateStatus(this)">
                    <option value="pending" <%= s.status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="approved" <%= s.status === 'approved' ? 'selected' : '' %>>Approved</option>
                    <option value="rejected" <%= s.status === 'rejected' ? 'selected' : '' %>>Fake</option>
                  </select>
                  <form action="/admin/<%= s.id %>/delete" method="POST" onsubmit="return confirm('Delete this submission?');">
                    <button type="submit" class="del-btn">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <div id="dup-modal-backdrop" class="dup-modal-backdrop" onclick="if(event.target===this) closeDupModal()">
    <div class="dup-modal">
      <div class="dup-modal-header">
        <h2>Merge duplicates</h2>
        <button type="button" class="dup-modal-close" onclick="closeDupModal()">&times;</button>
      </div>
      <p class="dup-modal-hint">Pick the submission to keep. The others in this group will be deleted.</p>
      <div id="dup-modal-list"></div>
      <div class="dup-modal-actions">
        <button type="button" class="btn-outline" onclick="closeDupModal()">Cancel</button>
        <button type="button" class="btn-primary" style="width:auto; margin-top:0;" onclick="confirmMerge()">Merge</button>
      </div>
    </div>
  </div>

  <script>
    const duplicateGroups = <%- JSON.stringify(duplicateGroups).replace(/</g, '\\u003c') %>;
    let activeGroupIndex = null;

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str == null ? '' : String(str);
      return div.innerHTML;
    }

    function openDupModal(groupIndex) {
      activeGroupIndex = groupIndex;
      const group = duplicateGroups[groupIndex];
      const list = document.getElementById('dup-modal-list');
      list.innerHTML = group.map((s, i) => `
        <label class="dup-entry">
          <input type="radio" name="dup-keep" value="${escapeHtml(s.id)}" ${i === 0 ? 'checked' : ''}>
          <img class="thumb" src="${escapeHtml(s.screenshot_url)}" alt="screenshot">
          <span class="dup-entry-info">
            <strong>${escapeHtml(s.name)}</strong>
            <span>${escapeHtml(s.phone)}</span>
            <span>${escapeHtml(s.social_media || '')}</span>
            <span>${escapeHtml(s.status)}</span>
            <span>${escapeHtml(s.created_at)}</span>
          </span>
        </label>
      `).join('');
      document.getElementById('dup-modal-backdrop').style.display = 'flex';
    }

    function closeDupModal() {
      document.getElementById('dup-modal-backdrop').style.display = 'none';
      activeGroupIndex = null;
    }

    async function confirmMerge() {
      const checked = document.querySelector('input[name="dup-keep"]:checked');
      if (!checked) return;
      const keepId = checked.value;
      const group = duplicateGroups[activeGroupIndex];
      const removeIds = group.map((s) => String(s.id)).filter((id) => id !== keepId).join(',');

      try {
        const res = await fetch('/admin/merge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `keepId=${encodeURIComponent(keepId)}&removeIds=${encodeURIComponent(removeIds)}`
        });
        if (!res.ok) throw new Error('failed');
        window.location.reload();
      } catch (err) {
        alert('Could not merge, please try again.');
      }
    }

    const labels = { pending: 'pending', approved: 'approved', rejected: 'fake' };

    async function updateStatus(select) {
      const id = select.dataset.id;
      const status = select.value;
      const badge = document.querySelector(`[data-badge-for="${id}"]`);
      const prevClass = badge.className;
      const prevText = badge.textContent;

      badge.className = `badge badge-${status}`;
      badge.textContent = labels[status];
      select.disabled = true;

      try {
        const res = await fetch(`/admin/${id}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `status=${encodeURIComponent(status)}`
        });
        if (!res.ok) throw new Error('failed');
      } catch (err) {
        badge.className = prevClass;
        badge.textContent = prevText;
        alert('Could not update status, please try again.');
      } finally {
        select.disabled = false;
      }
    }
  </script>
</body>
</html>
