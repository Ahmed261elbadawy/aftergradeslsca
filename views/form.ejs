<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>After Grad 2026 Registration</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="wrap">
    <div class="card">
      <h1 class="page-title">After Grad 2026</h1>
      <p class="subtitle page-subtitle">ESLSCA University, Class of 2026. Fill in your details and attach your payment screenshot.</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form action="/submit" method="POST" enctype="multipart/form-data">
        <label for="name">Full Name <span class="required-star">*</span></label>
        <input type="text" id="name" name="name" placeholder="e.g. Sara Ahmed" required>

        <label for="phone">Phone Number <span class="required-star">*</span></label>
        <input type="tel" id="phone" name="phone" placeholder="01xxxxxxxxx" required>

        <label for="email">Email <span class="required-star">*</span></label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>

        <label for="guest_of">If you're not an ESLSCAN, who are you coming with?</label>
        <input type="text" id="guest_of" name="guest_of" placeholder="e.g. name of the ESLSCA student you're attending with">
        <div class="help">Leave blank if you're an ESLSCA student.</div>

        <div class="pay-box">
          <div class="help" style="margin-top:0;">Pay via <strong>InstaPay</strong> or <strong>Telda</strong>:</div>
          <div class="pay-methods">
            <a class="pay-method" href="https://ipn.eg/S/at199166/instapay/2vq0Ou" target="_blank" rel="noopener">
              <img class="pay-method-icon" src="/images/logo-instapay.png" alt="InstaPay">
              <span>
                <span class="name">InstaPay</span>
                <span class="pay-method-sub">Tap to open payment link</span>
              </span>
            </a>
            <div class="pay-method">
              <img class="pay-method-icon" src="/images/logo-telda.jpg" alt="Telda">
              <span>
                <span class="name">Telda</span>
                <span class="pay-method-sub num">@ahmedelbadawy1</span>
              </span>
            </div>
          </div>
        </div>

        <label for="paid_to">Payment Method <span class="required-star">*</span></label>
        <select id="paid_to" name="paid_to" required>
          <option value="" disabled selected>Select how you paid</option>
          <option value="InstaPay">InstaPay</option>
          <option value="Telda">Telda</option>
        </select>

        <label for="screenshot">Payment Screenshot <span class="required-star">*</span></label>
        <input type="file" id="screenshot" name="screenshot" accept="image/*,.pdf" required>
        <div class="help">Upload a screenshot or PDF of your payment confirmation (max 8MB).</div>

        <button type="submit" class="btn-primary">Submit</button>
      </form>
    </div>
  </div>
</body>
</html>
